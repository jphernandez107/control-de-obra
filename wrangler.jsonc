{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "casa-cordoba",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The login gate must run before any file (including index.html) is served.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "casa-cordoba",
      "database_id": "0795f5be-940c-4da4-9351-a0ec2809e753",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "casa-cordoba-documents"
    }
  ],
  "vars": {
    "AI_PROVIDER": "disabled",
    "MAX_UPLOAD_MB": "5",
    "MAX_UPLOADS_PER_DAY": "100",
    "MAX_DOCUMENTS_TOTAL_MB": "2048"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
