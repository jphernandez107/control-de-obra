{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "casa-cordoba",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "obra.la-calandria.ar", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every response, assets included, passes through the Worker to get the security headers.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "casa-cordoba",
      "database_id": "0795f5be-940c-4da4-9351-a0ec2809e753",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "casa-cordoba-documents"
    }
  ],
  // Workers AI on the Free plan: 10,000 neurons/day, hard stop when used up (no billing). Resets 00:00 UTC.
  "ai": { "binding": "AI" },
  "vars": {
    "AI_PROVIDER": "cloudflare",
    "AI_TEXT_MODEL": "@cf/zai-org/glm-4.7-flash",
    "AI_VISION_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "AI_MAX_DOCUMENT_MB": "4",
    "AI_MAX_MESSAGES_PER_MINUTE": "8",
    "MAX_UPLOAD_MB": "5",
    "MAX_UPLOADS_PER_DAY": "100",
    "MAX_DOCUMENTS_TOTAL_MB": "2048"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
