# Casa Córdoba · Control de Obra — local configuration.
# Copy to `.env` (never commit real secrets). Every variable is optional.

# --- Database (SQLite file via libsql; D1-compatible schema) ---
DATABASE_URL=file:./data/casa-cordoba.db

# --- Document storage (local filesystem adapter) ---
DOCUMENTS_DIR=./data/documents

# --- API server ---
API_PORT=8787

# --- AI provider ---
# mock (local default): deterministic rule-based provider, no network. Used by tests.
# cloudflare: Cloudflare Workers AI. Valid setting, but the adapter is not connected yet
#             (it reports "La función de IA todavía no está configurada."); see docs/AI_HANDOFF.md.
# disabled: no AI; the assistant explains that AI is not configured (production default).
AI_PROVIDER=mock
# Model id for the cloudflare provider (unused by mock/disabled).
AI_MODEL=

# --- Identity ---
# dev: a fixed development user (DEV_USER_EMAIL, default: first user that can log in).
# cloudflare-access: trust the Cf-Access-Authenticated-User-Email header.
AUTH_MODE=dev
DEV_USER_EMAIL=juan@casacordoba.local

# Optional: pin a project id when the database holds more than one.
PROJECT_ID=

# --- Production (Cloudflare) ---
# Not read from this file. Non-secret settings are `vars` in wrangler.jsonc
# (AI_PROVIDER=disabled, MAX_UPLOAD_MB, MAX_UPLOADS_PER_DAY, MAX_DOCUMENTS_TOTAL_MB).
# The only secret is APP_USERS, set with `npx wrangler secret put APP_USERS`:
#   {"email@dominio": "<sha256 hex of the password>"}
