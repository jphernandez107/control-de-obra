# Casa Córdoba · Control de Obra — local configuration.
# Copy to `.env` (never commit real secrets). Every variable is optional.

# --- Database (SQLite file via libsql; D1-compatible schema) ---
DATABASE_URL=file:./data/casa-cordoba.db

# --- Document storage (local filesystem adapter) ---
DOCUMENTS_DIR=./data/documents

# --- API server ---
API_PORT=8787

# --- AI provider ---
# mock (local default): deterministic rule-based provider, no network. Used by tests.
# cloudflare: Cloudflare Workers AI. Only works inside the Worker (needs the `AI` binding);
#             production sets it in wrangler.jsonc together with AI_TEXT_MODEL / AI_VISION_MODEL.
# disabled: no AI; the assistant explains that AI is not configured.
AI_PROVIDER=mock

# --- Identity ---
# session (default): login screen with username + password, as in production.
#   Demo users from `npm run db:seed`: juan (administrator) and marcelo, password "casacordoba".
# dev: no login; act as DEV_USERNAME (default: first user that can log in).
AUTH_MODE=session
DEV_USERNAME=juan
# Send the session cookie only over HTTPS. Leave false for http://localhost.
SECURE_COOKIE=false

# Optional: pin a project id when the database holds more than one.
PROJECT_ID=

# --- Production (Cloudflare) ---
# Not read from this file. Non-secret settings are `vars` in wrangler.jsonc
# (AI_PROVIDER=cloudflare, AI_TEXT_MODEL, AI_VISION_MODEL, AI_MAX_DOCUMENT_MB, AI_MAX_MESSAGES_PER_MINUTE,
#  MAX_UPLOAD_MB, MAX_UPLOADS_PER_DAY, MAX_DOCUMENTS_TOTAL_MB).
# There are no secrets: users and password hashes live in D1.
# Set a password with `npm run cf:password -- <usuario>`.
